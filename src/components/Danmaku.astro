---
/**
 * 弹幕层：首屏的「脑内声音」。
 *
 * 每次加载从 thoughts 里随机挑 count 条横向飘过；
 * 滚过半屏后整层淡出 —— 弹幕是空气，不是正文，不能变成 B 站首页。
 *
 * category → 图标，weight → 字号/样式，规则见 src/content/about/thoughts.md。
 * weight: egg 的条目可点击，弹出 secrets 里对应的小窗。
 */
interface Thought {
  text: string;
  category: string;
  weight: string;
  speed: number;
  year?: number;
}

interface Secret {
  id: string;
  title: string;
  body: string;
}

interface Props {
  thoughts: Thought[];
  secrets?: Secret[];
  /** 一次同时飘多少条 */
  count?: number;
}

const { thoughts, secrets = [], count = 12 } = Astro.props;

const icons: Record<string, string> = {
  idea: '💭',
  game: '🎮',
  tech: '💻',
  night: '🌙',
  weird: '🌀',
  egg: '✦',
};
---

<div
  class="danmaku"
  id="danmaku-layer"
  data-thoughts={JSON.stringify(thoughts)}
  data-secrets={JSON.stringify(secrets)}
  data-icons={JSON.stringify(icons)}
  data-count={String(count)}
  aria-hidden="true"
></div>

<dialog class="secret" id="secret-dialog">
  <p class="secret-id"></p>
  <h3 class="secret-title"></h3>
  <p class="secret-body"></p>
  <button class="secret-close" type="button">Close</button>
</dialog>

<script>
  const layer = document.getElementById('danmaku-layer') as HTMLElement | null;
  const dialog = document.getElementById('secret-dialog') as HTMLDialogElement | null;

  if (layer) {
    const thoughts = JSON.parse(layer.dataset.thoughts || '[]') as any[];
    const secrets = JSON.parse(layer.dataset.secrets || '[]') as any[];
    const icons = JSON.parse(layer.dataset.icons || '{}') as Record<string, string>;
    const count = Number(layer.dataset.count || 12);
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (thoughts.length && !reduce) {
      const shuffle = (arr: any[]): any[] => {
        const a = arr.slice();
        for (let i = a.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          const tmp = a[i];
          a[i] = a[j];
          a[j] = tmp;
        }
        return a;
      };

      const pool = shuffle(thoughts.filter((t) => t.weight !== 'egg'));
      const eggs = thoughts.filter((t) => t.weight === 'egg');
      const picked = pool.slice(0, Math.min(count, pool.length));

      // 彩蛋低频出现：约 1/4 的概率随机顶替掉一条
      if (eggs.length && picked.length && Math.random() < 0.25) {
        picked[Math.floor(Math.random() * picked.length)] =
          eggs[Math.floor(Math.random() * eggs.length)];
      }

      const lanes = 7;
      // 飘过时长：默认 13 秒（20 秒太慢，完全不像弹幕），再叠 ±15% 随机
      const duration = (t: any) => `${((t.speed || 13) * (0.85 + Math.random() * 0.3)).toFixed(2)}s`;

      let cursor = 0;
      /** 给一条弹幕换内容／换道／换速度（用于循环复用） */
      const relaunch = (el: HTMLElement, t: any, i: number) => {
        el.className = `dm dm--${t.weight || 'normal'}`;
        el.textContent = `${icons[t.category] ?? ''} ${t.text}`.trim();
        // 分道，避免挤在同一条水平线上；再叠一点随机抖动
        const lane = i % lanes;
        el.style.top = `${(5 + lane * 12.5 + Math.random() * 3).toFixed(2)}%`;
        el.style.animationDuration = duration(t);
      };

      picked.forEach((t: any, i: number) => {
        const el = document.createElement('span');
        relaunch(el, t, i);
        // 负 delay：动画从行程中途开始 → 一打开页面就满屏弹幕，
        // 而不是从右侧一条一条慢慢爬进来（那才是不像弹幕的主因）
        const dur = parseFloat(el.style.animationDuration);
        el.style.animationDelay = `-${(Math.random() * dur).toFixed(2)}s`;

        if (t.weight === 'egg' && secrets.length) {
          el.dataset.egg = '1';
          const secret = secrets[Math.floor(Math.random() * secrets.length)];
          el.addEventListener('click', () => {
            if (!dialog) return;
            const id = dialog.querySelector('.secret-id');
            const title = dialog.querySelector('.secret-title');
            const body = dialog.querySelector('.secret-body');
            if (id) id.textContent = secret.id ?? '';
            if (title) title.textContent = secret.title ?? '';
            if (body) body.textContent = secret.body ?? '';
            dialog.showModal();
          });
        }

        // 飘完不消失，换一条继续飘——弹幕要一直在，不是一次性
        el.addEventListener('animationiteration', () => {
          if (el.dataset.egg === '1') {
            el.style.display = 'none'; // 彩蛋只出现一次
            return;
          }
          relaunch(el, pool[cursor++ % pool.length], Math.floor(Math.random() * lanes));
        });

        layer.appendChild(el);
      });
    }

    // 滚出首屏就淡出，正文区不留弹幕
    const onScroll = () => {
      layer.classList.toggle('is-out', window.scrollY > window.innerHeight * 0.55);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  if (dialog) {
    dialog.querySelector('.secret-close')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  }
</script>

<!--
  这里必须是 is:global —— 弹幕元素由 JS 动态创建，拿不到 Astro 注入的
  data-astro-cid-xxx 属性，scoped 选择器一条都匹配不上（表现为弹幕全堆在顶部一行）。
  类名都有 dm-/danmaku/secret 前缀，全局作用域不会撞车。
-->
<style is:global>
  .danmaku {
    position: absolute;
    /* 避开顶部固定导航栏 */
    top: var(--header-h, 60px);
    /* 撑满整个视口宽度：hero 自身受页面内边距限制，弹幕不能被关在中间 */
    left: 50%;
    width: 100vw;
    transform: translateX(-50%);
    height: calc(100% - var(--header-h, 60px));
    overflow: hidden;
    pointer-events: none;
    opacity: 1;
    transition: opacity 0.45s ease;
  }

  .danmaku.is-out {
    opacity: 0;
  }

  .dm {
    position: absolute;
    left: 100%;
    top: 0;
    white-space: nowrap;
    font-family: var(--ff-sans);
    font-size: 14px;
    font-weight: 500;
    line-height: 1;
    color: var(--c-text);
    /* 背景是插画，必须有白色描边托底，否则字会被画面吃掉 */
    text-shadow:
      0 0 3px rgba(255, 255, 255, 1),
      0 0 6px rgba(255, 255, 255, 0.95),
      0 0 10px rgba(255, 255, 255, 0.8),
      0 1px 1px rgba(255, 255, 255, 0.9);
    animation-name: dm-move;
    animation-timing-function: linear;
    animation-fill-mode: forwards;
    /* 一直飘：飘完换一条接着来，而不是一次性放完就空了 */
    animation-iteration-count: infinite;
    will-change: transform;
  }

  .dm--small {
    font-size: 12.5px;
    /* 插画背景上用 faint 会直接看不见，最低也得 dim */
    color: var(--c-text-dim);
    opacity: 0.92;
  }

  .dm--highlight {
    font-size: 17px;
    font-weight: 600;
    color: var(--c-text);
  }

  .dm--egg {
    font-family: var(--ff-mono);
    font-size: 12px;
    color: var(--c-accent);
    pointer-events: auto;
    cursor: pointer;
    border-bottom: 1px dashed currentColor;
    padding-bottom: 2px;
  }

  .danmaku.is-out .dm {
    animation-play-state: paused;
  }

  @keyframes dm-move {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-100vw - 100%));
    }
  }

  /* ---- 彩蛋小窗 ---- */
  .secret {
    max-width: 420px;
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    background: var(--c-glass-strong);
    backdrop-filter: blur(18px) saturate(120%);
    -webkit-backdrop-filter: blur(18px) saturate(120%);
    color: var(--c-text);
    padding: 26px 28px;
  }

  .secret::backdrop {
    background: rgba(23, 32, 51, 0.35);
  }

  .secret-id {
    font-family: var(--ff-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--c-accent);
    margin: 0 0 10px;
  }

  .secret-title {
    font-family: var(--ff-sans);
    font-size: 17px;
    font-weight: 500;
    margin: 0 0 10px;
  }

  .secret-body {
    font-family: var(--ff-sans);
    font-size: 13px;
    line-height: 1.7;
    color: var(--c-text-dim);
    margin: 0 0 20px;
    white-space: pre-line;
  }

  .secret-close {
    font-family: var(--ff-sans);
    font-size: 12px;
    color: var(--c-text-faint);
    background: none;
    border: 1px solid var(--c-border-soft);
    border-radius: var(--radius-sm);
    padding: 6px 14px;
    cursor: pointer;
  }

  .secret-close:hover {
    color: var(--c-accent-hover);
  }

  @media (prefers-reduced-motion: reduce) {
    .danmaku {
      display: none;
    }
  }
</style>
