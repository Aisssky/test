---
/**
 * 像素开屏页（旧站 pixel.html）。
 * DOM 与脚本逻辑原样迁移；跳转目标从 index.html 改为站点首页。
 * 像素字体在 article 之外的路径下由 pixel.css 经 Vite 解析，base 会正确带上。
 */
import Layout from '../layouts/Layout.astro';
import { withBase } from '../lib/site';
import '../styles/pixel.css';

const bootLines = [
  'AISSSKY BIOS v2.6.07',
  'CHECKING PIXEL FONT ........ OK',
  'LOADING PORTFOLIO.SYS ...... OK',
  'BOOT SEQUENCE COMPLETE.',
];

const binaryBackground =
  '';

const goHref = withBase('/');
---

<Layout
  title="Aisssky | PRESS START"
  description="Aisssky 像素黑白风开屏页"
  bodyClass="pixel-page"
>
  <div class="crt-flash" aria-hidden="true"></div>
  <div class="scanlines" aria-hidden="true"></div>

  <main class="screen">
    <div class="binary-bg" aria-hidden="true">{binaryBackground}</div>

    <pre class="boot" id="boot"></pre>

    <div class="stage" id="stage">
      <div class="invader" aria-hidden="true"></div>
      <h1>Aisssky<span class="cursor">█</span></h1>
      <div class="sub">UNREAL ENGINE DEVELOPER</div>
      <div class="tag">// MY OWN ONE PIECE</div>
      <a class="go" id="go" href={goHref}>[ GO! ]</a>
      <div class="hint">PRESS START</div>
    </div>

    <div class="foot">&copy; 2026 AISSSKY</div>
  </main>
</Layout>

<script is:inline define:vars={{ bootLines, goHref }}>
  (function () {
    var bootEl = document.getElementById('boot');
    var stageEl = document.getElementById('stage');
    var goEl = document.getElementById('go');

    var lines = bootLines;

    var started = false,
      finished = false,
      timers = [];
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function showStage() {
      if (finished) return;
      finished = true;
      timers.forEach(clearTimeout);
      bootEl.classList.add('done');
      bootEl.textContent = lines.join('\n');
      stageEl.classList.add('on');
    }

    function typeBoot() {
      started = true;
      var li = 0,
        ci = 0,
        out = '';
      (function tick() {
        if (finished) return;
        if (li >= lines.length) {
          timers.push(setTimeout(showStage, 260));
          return;
        }
        var line = lines[li];
        if (ci < line.length) {
          out += line[ci++];
          bootEl.textContent = out;
          timers.push(setTimeout(tick, 14));
        } else {
          out += '\n';
          li++;
          ci = 0;
          timers.push(setTimeout(tick, 140));
        }
      })();
    }

    // 开机白线动画结束后开始打字；点击/按键可跳过
    if (reduced) {
      showStage();
    } else {
      timers.push(setTimeout(typeBoot, 650));
    }

    document.addEventListener('click', function (e) {
      if (!finished && e.target !== goEl) showStage();
    });

    document.addEventListener('keydown', function (e) {
      if (!finished) {
        showStage();
        return;
      }
      if (e.key === 'Enter') goEl.click();
    });

    // 点击 GO!：先播放 CRT 关机动画，再跳转首页
    goEl.addEventListener('click', function (e) {
      e.preventDefault();
      if (document.body.classList.contains('off')) return;
      document.body.classList.add('off');
      setTimeout(
        function () {
          window.location.href = goHref;
        },
        reduced ? 0 : 380
      );
    });
  })();
</script>
