---
/**
 * 文章列表页 /blog/
 */
import PageLayout from '../../components/PageLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { collectCategories, getPublishedPosts } from '../../lib/posts';
import { categoryPath, withBase } from '../../lib/site';

const posts = await getPublishedPosts();
const categories = collectCategories(posts);
---

<PageLayout
  title="笔记"
  description="Aisssky 的技术笔记：UE5 / C++ / 图形学 / 项目开发日志"
>
  <div class="page-glass">
    {
      categories.length > 0 && (
        <div class="chip-list" style="margin-bottom: 28px;">
          <a class="chip chip-cat chip-lg" href={withBase('/categories/')}>
            全部分类 →
          </a>
          {categories.map((category) => (
            <a class="chip chip-tag chip-lg" href={categoryPath(category.name)}>
              {category.name} · {category.count}
            </a>
          ))}
        </div>
      )
    }

    {
      posts.length > 0 ? (
        <ul class="post-list">
          {posts.map((post) => (
            <PostCard post={post} />
          ))}
        </ul>
      ) : (
        <div class="empty">
          还没有文章。打开 <code>/admin/</code> 新建一篇，或者直接往
          <code>src/content/blog/</code> 里放一个 <code>.md</code> 文件。
        </div>
      )
    }
  </div>
</PageLayout>

<style>
  /* 和首页 / About 的玻璃面板同款外观，让列表页不再裸贴在背景上 */
  .page-glass {
    background: var(--c-glass);
    backdrop-filter: blur(18px) saturate(120%);
    -webkit-backdrop-filter: blur(18px) saturate(120%);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    padding: 26px 28px;
  }

  /* 卡片本身已是白底，套在玻璃里时去掉各自的边框，避免双重描边 */
  .page-glass :global(.post-card) {
    background: transparent;
    border: none;
    border-top: 1px solid var(--c-border-soft);
    border-radius: 0;
    padding: 20px 4px;
  }

  .page-glass :global(.post-card:first-child) {
    border-top: none;
  }

  @media (max-width: 720px) {
    .page-glass {
      padding: 20px 16px;
    }
  }
</style>
