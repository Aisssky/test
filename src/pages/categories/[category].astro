---
/**
 * 某个分类下的文章 /categories/<分类>/
 */
import PageLayout from '../../components/PageLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { collectCategories, getPublishedPosts } from '../../lib/posts';
import { withBase } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return collectCategories(posts).map((category) => ({
    params: { category: category.name },
    props: { name: category.name },
  }));
}

const { name } = Astro.props;
const posts = (await getPublishedPosts()).filter((post) => post.data.category === name);
---

<PageLayout
  title={`分类 · ${name}`}
  description={`分类「${name}」下的全部文章，共 ${posts.length} 篇`}
  subtitle={`${name} · 共 ${posts.length} 篇`}
>
  <p style="margin:-16px 0 28px;">
    <a href={withBase('/categories/')} style="color:#c2185b;font-size:14px;text-decoration:none;">
      ← 全部分类
    </a>
  </p>

  <ul class="post-list">
    {posts.map((post) => <PostCard post={post} />)}
  </ul>
</PageLayout>
