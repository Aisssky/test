---
/**
 * 首页：固定背景 + Hero + Writing + Notes + Selected。
 *
 * 彻底去掉了 Tailwind Play CDN 与 Google Fonts ——
 * 前者每次访问都要现编译一遍样式，后者在国内直连不通，
 * 首屏会长时间保持无样式状态。字体改用系统栈（见 theme.css）。
 */
import Layout from '../layouts/Layout.astro';
import SiteBackground from '../components/SiteBackground.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { getPublishedPosts } from '../lib/posts';
import { formatDate, postPath, withBase, SITE } from '../lib/site';

const posts = (await getPublishedPosts())
  .slice()
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const notes = [
  { label: 'Lua 脚本优化', href: null },
  { label: 'Games101/104', href: postPath('2026-05-30-games101-notes') },
  { label: '问题汇总', href: postPath('2026-02-17-ue5-qa') },
];

const currently = [
  { k: 'Building', v: '个人博客 · Astro + Decap CMS' },
  { k: 'Working', v: '《赛博朋克：飘渺城影》UE5 / UMG' },
  { k: 'Learning', v: 'Computer Graphics · GAMES101' },
];
---

<Layout
  title="Aisssky | Game Dev Portfolio"
  description="Unreal Engine Developer - My Own ONE PIECE"
  bodyClass="home"
>
  <SiteBackground veil={0.22} />
  <SiteHeader />

  <main id="main">
    <!-- Hero：第一屏不放任何文章卡片，让背景自己说话 -->
    <section class="hero">
      <div class="hero-inner">
        <h1 class="hero-name">Aisssky</h1>
        <p class="hero-line">Where the heart longs,<br />the soul follows.</p>
        <p class="hero-tags">C++ · Unreal Engine</p>
        <p class="hero-sub">Unreal Engine 5 · 独立游戏开发</p>
      </div>
      <div class="scroll-hint" aria-hidden="true">Scroll</div>
    </section>

    <div class="sections">
      <div class="col-main">
        <!-- Writing -->
        <section class="panel reveal">
          <div class="panel-head">
            <h2 class="eyebrow">Writing</h2>
            <a class="view-all" href={withBase('/blog/')}>View all →</a>
          </div>

          <ul class="entry-list">
            {
              posts.map((post) => (
                <li>
                  <a class="entry" href={postPath(post.id)}>
                    <span class="entry-date">{formatDate(post.data.pubDate)}</span>
                    <span class="entry-body">
                      <span class="entry-title">{post.data.title}</span>
                      {post.data.description && (
                        <span class="entry-desc">{post.data.description}</span>
                      )}
                      {(post.data.category || post.data.tags?.length) && (
                        <span class="entry-tags">
                          {post.data.category}
                          {post.data.category && post.data.tags?.length ? ' · ' : ''}
                          {post.data.tags?.slice(0, 2).join(' · ')}
                        </span>
                      )}
                    </span>
                    <span class="entry-arrow" aria-hidden="true">→</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>

        <!-- Notes：碎片化思考，和正式长文分开 -->
        <section class="panel reveal" id="notes">
          <div class="panel-head">
            <h2 class="eyebrow">Notes</h2>
          </div>
          <ul class="entry-list entry-list--plain">
            {
              notes.map((note) => (
                <li>
                  {note.href ? (
                    <a class="entry entry--plain" href={note.href}>
                      <span class="entry-title">{note.label}</span>
                      <span class="entry-arrow" aria-hidden="true">→</span>
                    </a>
                  ) : (
                    <span class="entry entry--plain is-muted">
                      <span class="entry-title">{note.label}</span>
                      <span class="entry-note">待整理</span>
                    </span>
                  )}
                </li>
              ))
            }
          </ul>
        </section>

        <!-- Selected work -->
        <section class="panel reveal">
          <div class="panel-head">
            <h2 class="eyebrow">Selected</h2>
          </div>
          <a
            class="entry entry--plain"
            href="https://store.steampowered.com/app/3552700/_/"
            target="_blank"
            rel="noopener"
          >
            <span class="entry-body">
              <span class="entry-title">《赛博朋克：飘渺城影》</span>
              <span class="entry-desc">对话系统 / 文本收集 / 教程系统 · UE5 C++ · UMG</span>
            </span>
            <span class="entry-arrow" aria-hidden="true">↗</span>
          </a>
        </section>
      </div>

      <!-- Currently：桌面端右侧，移动端自动落到最下面 -->
      <aside class="col-side">
        <section class="panel reveal">
          <div class="panel-head">
            <h2 class="eyebrow">Currently</h2>
          </div>
          <dl class="currently">
            {
              currently.map((item) => (
                <div>
                  <dt>{item.k}</dt>
                  <dd>{item.v}</dd>
                </div>
              ))
            }
          </dl>
        </section>
      </aside>
    </div>
  </main>

  <footer class="home-foot">
    <span>© {new Date().getFullYear()} Aisssky</span>
    <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
    <a href={SITE.github} target="_blank" rel="noopener">GitHub ↗</a>
  </footer>
</Layout>

<style>
  main {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 0 var(--page-pad) 80px;
  }

  /* ---- Hero ---- */
  .hero {
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding-top: var(--header-h);
  }

  .hero-name {
    font-family: var(--ff-sans);
    font-size: clamp(38px, 7vw, 74px);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--c-text);
    margin: 0 0 18px;
  }

  .hero-line {
    font-family: var(--ff-serif);
    font-size: clamp(19px, 2.6vw, 27px);
    line-height: 1.45;
    color: var(--c-text);
    margin: 0 0 26px;
  }

  .hero-tags {
    font-family: var(--ff-mono);
    font-size: 13px;
    letter-spacing: 0.05em;
    color: var(--c-accent);
    margin: 0 0 6px;
  }

  .hero-sub {
    font-family: var(--ff-sans);
    font-size: 13px;
    color: var(--c-text-dim);
    margin: 0;
  }

  .scroll-hint {
    position: absolute;
    bottom: 38px;
    font-family: var(--ff-sans);
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--c-text-faint);
  }

  .hero {
    position: relative;
  }

  /* ---- 区块布局 ---- */
  .sections {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: 24px;
    align-items: start;
  }

  .col-main,
  .col-side {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .col-side {
    position: sticky;
    top: calc(var(--header-h) + 24px);
  }

  .panel {
    background: var(--c-glass);
    backdrop-filter: blur(18px) saturate(120%);
    -webkit-backdrop-filter: blur(18px) saturate(120%);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    padding: 26px 28px;
  }

  .panel-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 14px;
  }

  .view-all {
    font-family: var(--ff-sans);
    font-size: 12px;
    color: var(--c-accent);
    text-decoration: none;
  }

  .view-all:hover {
    color: var(--c-accent-hover);
  }

  /* ---- 条目：靠间距和细线分层，不做卡片 ---- */
  .entry-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .entry-list li + li {
    border-top: 1px solid var(--c-border-soft);
  }

  .entry {
    display: flex;
    align-items: baseline;
    gap: 18px;
    padding: 16px 0;
    text-decoration: none;
    color: inherit;
  }

  .entry--plain {
    align-items: center;
  }

  .entry-date {
    font-family: var(--ff-mono);
    font-size: 12px;
    color: var(--c-text-faint);
    flex: 0 0 62px;
  }

  .entry-body {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .entry-title {
    font-family: var(--ff-sans);
    font-size: 15px;
    font-weight: 500;
    color: var(--c-text);
  }

  .entry-desc {
    font-family: var(--ff-sans);
    font-size: 13px;
    color: var(--c-text-dim);
    line-height: 1.55;
  }

  .entry-tags {
    font-family: var(--ff-mono);
    font-size: 11px;
    color: var(--c-text-faint);
    margin-top: 2px;
  }

  .entry-note {
    font-family: var(--ff-sans);
    font-size: 11px;
    color: var(--c-text-faint);
  }

  .entry-arrow {
    flex: 0 0 auto;
    font-size: 14px;
    color: var(--c-text-faint);
    transition: transform 0.18s ease;
  }

  .entry:hover .entry-arrow {
    transform: translateX(4px);
    color: var(--c-accent-hover);
  }

  .entry:hover .entry-title {
    color: var(--c-accent-hover);
  }

  .is-muted .entry-title {
    color: var(--c-text-faint);
  }

  /* ---- Currently ---- */
  .currently {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .currently dt {
    font-family: var(--ff-sans);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-text-faint);
    margin-bottom: 3px;
  }

  .currently dd {
    margin: 0;
    font-family: var(--ff-sans);
    font-size: 13px;
    line-height: 1.5;
    color: var(--c-text);
  }

  /* ---- 页脚 ---- */
  .home-foot {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 0 var(--page-pad) 48px;
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    font-family: var(--ff-sans);
    font-size: 12px;
    color: var(--c-text-faint);
  }

  .home-foot a {
    color: var(--c-text-faint);
    text-decoration: none;
  }

  .home-foot a:hover {
    color: var(--c-accent-hover);
  }

  /* ---- 进入动画：只做 opacity + 轻微位移 ---- */
  .reveal {
    animation: rise 0.5s ease both;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      animation: none;
    }
  }

  @media (max-width: 880px) {
    .sections {
      grid-template-columns: minmax(0, 1fr);
    }
    .col-side {
      position: static;
    }
    .hero {
      min-height: 90svh;
    }
    .panel {
      padding: 22px 20px;
    }
  }
</style>
